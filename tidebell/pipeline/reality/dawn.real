# Tidebell ending: dawn over the quiet Maw, a bell hung again on its post.
camera { position: [0, 1.2, 8], look_at: [0, 1.4, 0], lens: 28mm, aperture: f/11 }
sky { sun_elevation: 3, sun_azimuth: 12, haze: 1.6 }
film { bloom: 0.02, vignette: 0.5, saturation: 1.1 }
render { resolution: [320, 224], samples: 48, bounces: 5 }

plane { position: [0, 0, 0], material: water { color: #203a58 } }
rock { position: [-3.6, -0.5, 1.5], radius: 1.4, seed: 21, scale: [1.3, 0.6, 1.0], material: matte { color: #3c3834 } }
let wood = matte { color: #4a3220 }
cylinder { position: [-3.4, 0.2, 1.5], radius: 0.08, height: 3.2, material: wood }
box { position: [-3.0, 3.35, 1.5], size: [1.0, 0.1, 0.1], material: wood }
let bronze = metal { color: #c8962c, roughness: 0.3 }
sphere { position: [-2.7, 2.75, 1.5], radius: 0.24, material: bronze }
cylinder { position: [-2.7, 3.12, 1.5], radius: 0.02, height: 0.3, material: wood }
cylinder { position: [-2.7, 2.35, 1.5], radius: 0.27, height: 0.38, material: bronze }
rock { position: [5, -0.6, -6], radius: 2.0, seed: 22, scale: [1.8, 0.5, 1.0], material: matte { color: #2e3440 } }
